{
  "name": "CommunityListing",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "Business",
        "Club & Group",
        "Education",
        "What's On"
      ],
      "enumNames": [
        "Business",
        "Club & Group",
        "Education",
        "What's On"
      ]
    },
    "category": {
      "type": "string",
      "title": "Category / Trade Type"
    },
    "country": {
      "type": "string",
      "title": "Country",
      "default": "Ireland"
    },
    "county": {
      "type": "string",
      "title": "County"
    },
    "town": {
      "type": "string",
      "title": "Townland / Village"
    },
    "area": {
      "type": "string",
      "title": "Nearest Town / Area"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "website": {
      "type": "string",
      "title": "Website"
    },
    "facebook_url": {
      "type": "string",
      "title": "Facebook URL"
    },
    "instagram_url": {
      "type": "string",
      "title": "Instagram URL"
    },
    "linkedin_url": {
      "type": "string",
      "title": "LinkedIn URL"
    },
    "contact_name": {
      "type": "string",
      "title": "Contact Name"
    },
    "meeting_info": {
      "type": "string",
      "title": "Meeting Info"
    },
    "event_date": {
      "type": "string",
      "title": "Event Start Date (YYYY-MM-DD)"
    },
    "event_date_end": {
      "type": "string",
      "title": "Event End Date (YYYY-MM-DD)"
    },
    "event_time": {
      "type": "string",
      "title": "Event Time (HH:MM)"
    },
    "is_recurring": {
      "type": "boolean",
      "title": "Is Recurring?",
      "default": false
    },
    "recurring_type": {
      "type": "string",
      "title": "Recurring Type",
      "enum": [
        "daily",
        "weekly",
        "fortnightly",
        "monthly_date",
        "twice_monthly",
        "monthly_weekday",
        "2nd_4th_weekday"
      ],
      "enumNames": [
        "Daily",
        "Weekly",
        "Fortnightly",
        "Monthly on a date",
        "Twice a month",
        "Monthly by weekday (e.g. 1st Monday)",
        "2nd & 4th weekday of month (e.g. Toastmasters)"
      ]
    },
    "recurring_day": {
      "type": "string",
      "title": "Recurring Schedule Detail"
    },
    "is_free": {
      "type": "boolean",
      "title": "Is Free Entry?"
    },
    "is_featured": {
      "type": "boolean",
      "title": "Is Featured",
      "default": false
    },
    "is_verified": {
      "type": "boolean",
      "title": "Is Verified",
      "default": false
    },
    "owner_email": {
      "type": "string",
      "title": "Owner Email"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL"
    }
  },
  "required": [
    "name",
    "type",
    "county",
    "town"
  ]
}