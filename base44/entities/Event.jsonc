{
  "name": "Event",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Event Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "event_date": {
      "type": "string",
      "title": "Event Date (YYYY-MM-DD)"
    },
    "event_time": {
      "type": "string",
      "title": "Event Time (e.g. 7:30pm)"
    },
    "is_recurring": {
      "type": "boolean",
      "title": "Recurring Weekly?",
      "default": false
    },
    "recurring_day": {
      "type": "string",
      "title": "Recurring Day of Week"
    },
    "is_free": {
      "type": "boolean",
      "title": "Is Free Entry?"
    },
    "county": {
      "type": "string",
      "title": "County"
    },
    "town": {
      "type": "string",
      "title": "Town / Village"
    },
    "area": {
      "type": "string",
      "title": "Nearest Town / Area"
    },
    "address": {
      "type": "string",
      "title": "Venue / Address"
    },
    "contact_name": {
      "type": "string",
      "title": "Contact Name"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "website": {
      "type": "string",
      "title": "Website / Tickets URL"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL"
    },
    "is_featured": {
      "type": "boolean",
      "title": "Is Featured",
      "default": false
    },
    "parent_listing_id": {
      "type": "string",
      "title": "Linked Listing ID (optional)"
    },
    "parent_listing_name": {
      "type": "string",
      "title": "Linked Listing Name"
    }
  },
  "required": [
    "name",
    "county",
    "town"
  ]
}