{
  "name": "ListingEngagement",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string",
      "title": "Listing ID"
    },
    "event_type": {
      "type": "string",
      "title": "Event Type",
      "enum": [
        "view",
        "phone_click",
        "website_click",
        "email_click",
        "facebook_click",
        "instagram_click",
        "linkedin_click"
      ]
    },
    "listing_owner_email": {
      "type": "string",
      "title": "Listing Owner Email"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    }
  },
  "required": [
    "listing_id",
    "event_type"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.listing_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}